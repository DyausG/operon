{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeAndStopOperonRuntime",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:InvokeAgentRuntime", "bedrock-agentcore:StopRuntimeSession"],
      "Resource": ["${RUNTIME_ARN}", "${RUNTIME_ENDPOINT_ARN}"]
    },
    {
      "Sid": "ForbidUserImpersonationInvocation",
      "Effect": "Deny",
      "Action": "bedrock-agentcore:InvokeAgentRuntimeForUser",
      "Resource": "*"
    }
  ]
}
