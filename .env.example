# ---------------------------------------------------------------------------
# Operon — environment configuration (copy to `.env`, never commit real keys)
# ---------------------------------------------------------------------------
# Operon runs fully WITHOUT any of these: deterministic telemetry, health
# scoring, incidents, governance, approvals and the Guided Demo all work (the
# Guided Demo then uses a labelled deterministic advisory, no model), and
# model-backed reasoning truthfully reports itself as unavailable. With a
# provider configured, the Guided Demo's incident reasons on that provider.
#
# To enable model-backed reasoning configure ONE provider. Secrets are read by
# the server only; they never reach the browser, logs or the API.
# Provider details: docs/DEMO.md · architecture: docs/PROVIDERS.md
# ---------------------------------------------------------------------------

# --- Active provider ---------------------------------------------------------
# auto (default) = first configured cloud provider (Gemini key, then AWS creds), else none
# none | gemini | ollama | bedrock select explicitly.
# (legacy alias: SENTINEL_LLM_PROVIDER, where "deterministic" means none)
# OPERON_AI_PROVIDER=auto

# Force the no-provider mode even if credentials exist (public/hosted demos).
# This is a process-start lock: Settings → AI provider refuses selection while it is set.
# POC_FORCE_DETERMINISTIC=1

# --- Google Gemini -------------------------------------------------------------
# Key: https://aistudio.google.com/apikey (free tier). Server-side only.
# GEMINI_API_KEY=
# OPERON_GEMINI_MODEL=gemini-flash-latest   # any Gemini model id (legacy alias: GEMINI_MODEL_ID)
# OPERON_GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_TOKENS=1024
# GEMINI_RPM=12               # client-side requests/min cap (free-tier friendly)
# GEMINI_MAX_RETRIES=5        # retry transient 429/5xx with exponential backoff

# --- Ollama / local open-source models --------------------------------------
# Install and start Ollama yourself; Operon never installs it or pulls models.
# OPERON_OLLAMA_BASE_URL=http://127.0.0.1:11434   # (legacy alias: OLLAMA_HOST)
# OPERON_OLLAMA_MODEL=qwen2.5:7b                  # a model already pulled (`ollama list`)
# OPERON_OLLAMA_TIMEOUT_SECONDS=120

# --- AWS Bedrock (optional; never required to start) ------------------------
# Credentials come from the standard AWS chain: `aws configure`, AWS_PROFILE,
# a role, or explicit keys (prefer short-lived / least-privilege).
# AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Model id or cross-region inference profile enabled under Bedrock → Model access.
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MAX_TOKENS=1024

# --- Reasoning backend (supervisor + specialists) ----------------------------
# none | local | packet | agentcore. Unset = local when a provider is configured, else none.
# OPERON_REASONING_BACKEND=local
# Optional distinct specialist model for the active provider (defaults to the provider model).
# OPERON_SPECIALIST_MODEL_ID=

# --- AgentCore remote runtime (Bedrock-only; see docs/AGENTCORE_DEPLOYMENT.md) ---
# OPERON_REASONING_BACKEND=agentcore
# OPERON_AGENTCORE_RUNTIME_ARN=
# OPERON_AGENTCORE_QUALIFIER=DEFAULT
# OPERON_AGENTCORE_REGION=us-east-1
# Both model/inference-profile IDs are required in AgentCore mode.
# OPERON_BEDROCK_SUPERVISOR_MODEL_ID=
# OPERON_BEDROCK_SPECIALIST_MODEL_ID=

# --- Server / demo tuning (all optional) -------------------------------------
# POC_HOST=127.0.0.1
# POC_PORT=8000
# POC_TICK_SECONDS=1.0          # wall-clock seconds per simulated tick
# POC_PLANT_NAME=Demo Manufacturing Plant 01
# OPERON_OPEN_BROWSER=0         # run.py: do not open a browser tab
# OPERON_TRUSTED_SUBMISSIONS=1  # enable trusted confirmation endpoints + non-loopback secret submission
