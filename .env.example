# ---------------------------------------------------------------------------
# Operon — environment configuration (copy to `.env`, never commit real keys)
# ---------------------------------------------------------------------------
# The demo runs fully WITHOUT any of these (deterministic agent). To switch on a
# live tool-calling agent, provide credentials for ONE provider:
#   * Google Gemini — recommended for this POC (generous free tier), or
#   * AWS Bedrock   — kept for the later scale / real-data phase.
#
# Provider is auto-selected: Gemini if a key is set, else Bedrock, else the
# deterministic planner. Force one with SENTINEL_LLM_PROVIDER.
# ---------------------------------------------------------------------------

# Which provider to use: auto (default) | gemini | bedrock | deterministic
# SENTINEL_LLM_PROVIDER=auto

# --- Google Gemini (live agent — free tier; the POC default) ---
# Get a key at https://aistudio.google.com/apikey  (free tier, no card).
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-flash-latest   # alias to the current flash model (recommended)
# GEMINI_MAX_TOKENS=1024
# Free-tier friendliness (client-side rate limit + retry with backoff):
# GEMINI_RPM=12               # cap requests/min under the free-tier ceiling
# GEMINI_MAX_RETRIES=5        # retry transient 429/5xx with exponential backoff

# --- AWS Bedrock (live agent — kept for the scale / real-data phase) ---
AWS_REGION=us-east-1
# Option A: a named profile you've already configured with `aws configure`
# AWS_PROFILE=default
# Option B: explicit keys (prefer a short-lived / least-privilege user)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Bedrock model id (must be enabled in your account/region under Model Access).
# Cross-region inference profile ids ("us.anthropic...") work in most accounts.
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MAX_TOKENS=1024

# --- Step 15 AgentCore reasoning runtime (optional; no values are assumed) ---
# OPERON_REASONING_BACKEND=agentcore
# OPERON_AGENTCORE_RUNTIME_ARN=
# OPERON_AGENTCORE_QUALIFIER=DEFAULT
# OPERON_AGENTCORE_REGION=us-east-1
# Both model/inference-profile IDs are required in AgentCore mode and must be
# verified against the target AWS account during live preflight.
# OPERON_BEDROCK_SUPERVISOR_MODEL_ID=
# OPERON_BEDROCK_SPECIALIST_MODEL_ID=

# --- Demo tuning (all optional) ---
# POC_TICK_SECONDS=1.0          # wall-clock seconds per simulated tick
# POC_HOST=127.0.0.1
# POC_PORT=8000
# POC_PLANT_NAME=Demo Manufacturing Plant 01
# POC_FORCE_DETERMINISTIC=1     # force deterministic mode even if creds exist
